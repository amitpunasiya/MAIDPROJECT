# ==========================================
# SERVER CONFIGURATION
# ==========================================
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
LOG_LEVEL=info

# ==========================================
# DATABASE
# ==========================================
# MongoDB Connection String (Atlas or local)
MONGODB_URI=mongodb://localhost:27017/maid_cook_db

# ==========================================
# JWT SECURITY (Minimum 32 Characters Each)
# ==========================================
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_long_for_security
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_long_for_security
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# CORS & COOKIES
# ==========================================
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
REFRESH_TOKEN_COOKIE_NAME=refreshToken
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ==========================================
# FIREBASE ADMIN SDK (Phone OTP Verification)
# ==========================================
FIREBASE_PROJECT_ID=demo-maid-cook-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-demo@demo-maid-cook-app.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQCdemo...\n-----END PRIVATE KEY-----\n"

# ==========================================
# CLOUDINARY (Media & Profile Photo Uploads - Optional)
# ==========================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==========================================
# RATE LIMITING
# ==========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=20

# ==========================================
# REDIS (Optional — leave empty to disable cache)
# ==========================================
# Local:  redis://localhost:6379
# Auth:   redis://:password@localhost:6379
# TLS:    rediss://user:password@host:6380
REDIS_URL=

# ==========================================
# OBSERVABILITY
# ==========================================
# Log MongoDB queries slower than this threshold (ms). Set 0 to disable.
SLOW_QUERY_THRESHOLD_MS=100

# Expose Prometheus metrics at GET /api/v1/metrics
# IMPORTANT: protect this endpoint at the network/ingress level in production
PROMETHEUS_ENABLED=false

# ==========================================
# SCHEDULER
# ==========================================
# Enable the cron job scheduler on startup
CRON_ENABLED=true

# ==========================================
# OTHER SERVICES (Optional)
# ==========================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
GOOGLE_MAPS_API_KEY=

# ==========================================
# SEED UTILITY
# ==========================================
SEED_ADMIN_EMAIL=admin@maidapp.com
SEED_ADMIN_PASSWORD=Admin@123456
